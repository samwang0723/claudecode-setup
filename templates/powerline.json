{
  "display": {
    "autoWrap": true,
    "padding": 1,
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": true,
            "style": "basename"
          },
          "git": {
            "enabled": true
          },
          "tmux": {
            "enabled": true
          },
          "model": {
            "enabled": true
          }
        }
      },
      {
        "segments": {
          "session": {
            "enabled": true,
            "type": "both",
            "costSource": "calculated"
          },
          "today": {
            "enabled": true,
            "type": "both"
          },
          "context": {
            "enabled": true,
            "displayStyle": "dots",
            "percentageMode": "used"
          }
        }
      },
      {
        "segments": {
          "metrics": {
            "enabled": true,
            "showResponseTime": true,
            "showLastResponseTime": false,
            "showDuration": true,
            "showMessageCount": true,
            "showLinesAdded": true,
            "showLinesRemoved": true
          },
          "env": {
            "enabled": true,
            "variable": "CLAUDE_ACCOUNT",
            "prefix": "Acct"
          }
        }
      }
    ]
  }
}
